{
  "name": "chronoveil",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "check": "pnpm run check:deps && pnpm run check:whitelist && pnpm run check:ipc && pnpm run check:rust && tsc --noEmit && pnpm run test",
    "check:deps": "depcruise src --config .dependency-cruiser.cjs",
    "check:whitelist": "node scripts/check-dependency-whitelist.mjs",
    "check:ipc": "node scripts/check-ipc-whitelist.mjs",
    "check:rust": "node scripts/check-rust-boundaries.mjs"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.65.0",
    "@fluentui/react-icons": "^2.0.339",
    "@tauri-apps/api": "^2.11.1",
    "i18next": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "dependency-cruiser": "^16.10.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}